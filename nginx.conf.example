# Ejemplo para nginx. Después: sudo certbot --nginx -d midominio.com  (activa HTTPS)
map $http_upgrade $connection_upgrade { default upgrade; '' close; }

server {
    listen 80;
    server_name midominio.com;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;          # necesario para el WebSocket
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;                      # el servidor lo usa para validar el origen
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 3600s;
    }
}
